        {
          "claim": "研究使用Yebes 40 m、IRAM 30 m和APEX，覆盖31–275 GHz、约150 GHz带宽。",
          "sourceUrl": "https://arxiv.org/abs/2610.39654",
          "locator": "摘要 Methods 段",
