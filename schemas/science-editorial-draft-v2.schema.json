{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "LearningOS Science Editorial Draft V2 — Claim Evidence",
  "type": "object",
  "required": ["schemaVersion", "kind", "draftId", "date", "articles"],
  "properties": {
    "schemaVersion": {"const": "2.0"},
    "kind": {"const": "science_editorial_draft"},
    "draftId": {"type": "string", "minLength": 1},
    "date": {"type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$"},
    "articles": {"type": "array", "minItems": 1, "items": {"type": "object", "required": ["id", "status", "doi", "title", "originalTitle", "journal", "authors", "paperPublicationDate", "sources", "evidence", "claims", "body"], "properties": {"id": {"type":"string","minLength":1}, "status": {"enum":["Draft","Needs More Evidence","Reviewed","ApprovedForHumanReview","Ready","Published","Rejected"]}, "doi": {"type":"string","pattern":"^10\\.\\S+\\/\\S+$"}, "title":{"type":"string","minLength":1}, "originalTitle":{"type":"string","minLength":1}, "journal":{"type":"string","minLength":1}, "authors":{"type":"array","minItems":1}, "paperPublicationDate":{"type":"string","pattern":"^\\d{4}-\\d{2}-\\d{2}$"}, "sources":{"type":"array","minItems":1}, "evidence":{"type":"array","minItems":1,"items":{"type":"object","required":["evidenceId","claimId","sourceDoi","sourceUrl","locator","checkedContent","verificationStatus","verificationRecord"]}}, "claims":{"type":"array","minItems":1,"items":{"type":"object","required":["claimId","text","claimType","evidenceRefs","editorialFactCheck"]}}, "body":{"type":"array","minItems":3}}}}
  }
}
