{
 "$schema":"https://json-schema.org/draft/2020-12/schema",
 "title":"THE DAILY Science Editorial Draft",
 "type":"object","required":["schemaVersion","kind","articleId","editorialStatus","category","topic","headline","subheadline","publication","lead","researchQuestion","methods","keyFindings","quantitativeResults","limitations","broaderSignificance","sources","claims","verificationWarnings"],
 "properties":{
  "schemaVersion":{"const":"1.0"},"kind":{"const":"science_editorial_draft"},"articleId":{"type":"string","pattern":"^science-[a-z0-9-]+$"},
  "editorialStatus":{"enum":["Draft","Reviewed","ApprovedForHumanReview","Published","Rejected"]},"category":{"const":"Science"},"topic":{"type":"string","minLength":1},
  "headline":{"type":"string","minLength":1},"subheadline":{"type":"string","minLength":1},"publication":{"type":"object","required":["doi","title","journal","publicationDate","publicationDatePrecision"],"properties":{"doi":{"type":"string","pattern":"^10\\.\\d{4,9}/\\S+$"},"title":{"type":"string"},"journal":{"type":"string"},"publicationDate":{"type":"string"},"publicationDatePrecision":{"enum":["day","month","year","unknown"]}}},
  "lead":{"type":"string","minLength":1},"researchQuestion":{"type":"string","minLength":1},"methods":{"type":"string","minLength":1},"keyFindings":{"type":"array","minItems":1,"items":{"type":"string"}},"quantitativeResults":{"type":"array","items":{"type":"object","required":["value","unit","evidenceRefs"],"properties":{"value":{"type":"string"},"unit":{"type":"string"},"evidenceRefs":{"type":"array","minItems":1,"items":{"type":"string"}}}}},
  "limitations":{"type":"array","minItems":1,"items":{"type":"string"}},"broaderSignificance":{"type":"string","minLength":1},
  "sources":{"type":"array","minItems":1,"items":{"type":"object","required":["doi","url","sourceType"],"properties":{"doi":{"type":"string"},"url":{"type":"string","pattern":"^https://"},"sourceType":{"enum":["publisher_abstract","preprint_abstract","full_text","supplementary_information","institutional_copy"]}}}},
  "claims":{"type":"array","minItems":1,"items":{"type":"object","required":["claimId","text","claimType","evidenceRefs","supportLevel"],"properties":{"claimId":{"type":"string"},"text":{"type":"string"},"claimType":{"enum":["sourced_fact","interpretation","context"]},"evidenceRefs":{"type":"array","minItems":1,"items":{"type":"string"}},"supportLevel":{"enum":["verified_metadata","abstract_supported","full_text_supported","unverified"]}}}},
  "verificationWarnings":{"type":"array","items":{"type":"string"}}
 },
 "additionalProperties":false
}