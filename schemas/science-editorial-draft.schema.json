{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "LearningOS Science Editorial Draft",
  "type": "object",
  "required": ["schemaVersion", "kind", "draftId", "date", "articles"],
  "properties": {
    "schemaVersion": {"const": "1.0"},
    "kind": {"const": "science_editorial_draft"},
    "draftId": {"type": "string", "minLength": 1},
    "date": {"type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$"},
    "articles": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "status", "doi", "title", "journal", "authors", "paperPublicationDate", "sources", "evidence", "body"],
        "properties": {
          "id": {"type": "string", "minLength": 1},
          "status": {"enum": ["Draft", "Needs More Evidence", "Ready", "Published", "Rejected"]},
          "doi": {"type": "string", "pattern": "^10\\.\\S+\\/\\S+$"},
          "title": {"type": "string", "minLength": 1},
          "journal": {"type": "string", "minLength": 1},
          "authors": {"type": "array", "minItems": 1},
          "paperPublicationDate": {"type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$"},
          "sources": {"type": "array", "minItems": 1},
          "evidence": {"type": "array", "minItems": 1},
          "doiVerification": {"type": "object"},
          "body": {"type": "array", "minItems": 3}
        }
      }
    }
  }
}
